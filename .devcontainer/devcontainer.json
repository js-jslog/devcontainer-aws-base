{
  "name": "AWS dev container",
  "image": "jslog/devcontainer-aws-base:latest",
  "remoteUser": "dev",
  "appPort": [3000],
  /* The `mount` property allows for a more readable syntax (using object notation),
    however, you then end up with a workspace mount being created in addition. This
    pair of properties ensures that the "workspace" is set to the /app directory as
    we would want, and that it is a volume, rather than a mount */
  "workspaceMount": "source=devcontainer-aws-base-volume,target=/app,type=volume",
  "workspaceFolder": "/app",
  /* Everything below /home/dev lives in the container's writable layer and is
     destroyed on every image bump. These volumes keep the expensive and the
     sensitive out of that layer:
     - .config/nvim      : lets in-progress neovim-config branch work survive a rebuild
     - .local/share/nvim : Mason downloads and LSP indexes (the big one)
     - .local/share/pnpm : pnpm content-addressable store
     - .aws              : SSO config and cached short-lived credentials
     - .kube, .gradle, .terraform.d/plugin-cache : caches and cluster config
     Each target is pre-created and chowned to dev in the Dockerfile; without that
     Docker would create them root-owned and unwritable. */
  "mounts": [
    "source=aws-base-nvim-config,target=/home/dev/.config/nvim,type=volume",
    "source=aws-base-nvim-data,target=/home/dev/.local/share/nvim,type=volume",
    "source=aws-base-pnpm-store,target=/home/dev/.local/share/pnpm,type=volume",
    "source=aws-base-aws,target=/home/dev/.aws,type=volume",
    "source=aws-base-kube,target=/home/dev/.kube,type=volume",
    "source=aws-base-gradle,target=/home/dev/.gradle,type=volume",
    "source=aws-base-tf-cache,target=/home/dev/.terraform.d/plugin-cache,type=volume"
  ],
  /* Docker-in-Docker. Needed here for `sam local invoke`, Lambda container
     images and ECR pushes - not merely "just in case" as in node-base. */
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true,
      "dockerDashComposeVersion": "v2",
      "installDockerBuildx": true
    }
  },
  /* Allow the Docker init script from the DinD feature to run. If we remove
     DinD, this should also be removed, and then so should the CMD in the
     Dockerfile */
  "overrideCommand": false,
  "customizations": {
    "vscode": {
      /* Declared as an escape hatch, not the primary workflow. Neovim remains
         the default editor; these cost nothing until VS Code is used to attach,
         and cover the cases where a language server is genuinely easier there. */
      "extensions": [
        "amazonwebservices.aws-toolkit-vscode",
        "hashicorp.terraform",
        "ms-python.python",
        "vscjava.vscode-java-pack",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "dev.containers.forwardWSLServices": false,
        "dev.containers.dockerCredentialHelper": false,
        "dev.containers.gitCredentialHelperConfigLocation": "none"
      }
    }
  }
}
